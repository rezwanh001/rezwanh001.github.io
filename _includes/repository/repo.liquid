{% comment %}
  Native repository card. Renders entirely from baked data in
  _data/repositories.yml — no dependency on github-readme-stats.
  `include.repository` is one entry from `github_repos` (an object).
  Star / fork counts are refreshed live in the browser (see repositories.md)
  and gracefully fall back to the baked values below.
{% endcomment %}
{% assign r = include.repository %}
{% assign slug = r.repo | split: '/' %}
{% assign owner = slug[0] %}
{% assign name = slug[1] %}

<div class="repo p-2">
  <a
    class="repo-card"
    href="https://github.com/{{ r.repo }}"
    target="_blank"
    rel="noopener"
    data-repo="{{ r.repo }}"
  >
    <div class="repo-card-top">
      <span class="repo-card-icon"><i class="fa-solid fa-book-bookmark"></i></span>
      <span class="repo-card-title">
        <span class="repo-card-owner">{{ owner }}/</span><span class="repo-card-name">{{ name }}</span>
      </span>
    </div>

    {% if r.description %}
    <p class="repo-card-desc">{{ r.description }}</p>
    {% endif %}

    <div class="repo-card-foot">
      {% if r.language %}
      <span class="repo-card-lang">
        <span class="repo-card-dot" style="background-color: {{ r.lang_color | default: '#8b8b8b' }};"></span>
        {{ r.language }}
      </span>
      {% endif %}
      <span class="repo-card-stat" data-stat="stars" title="Stars">
        <i class="fa-solid fa-star"></i> <span class="repo-card-num">{{ r.stars | default: 0 }}</span>
      </span>
      <span class="repo-card-stat" data-stat="forks" title="Forks">
        <i class="fa-solid fa-code-branch"></i> <span class="repo-card-num">{{ r.forks | default: 0 }}</span>
      </span>
      {% if r.homepage %}
      <span class="repo-card-link" title="Project page / paper">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
      </span>
      {% endif %}
    </div>
  </a>
</div>
